# ==============================================================================
# CIVORA - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: Render (Backend) + Supabase (Database & Storage) + Vercel (Frontend)
#
# DO NOT commit production credentials to version control.
# Values marked [PENDING] must be retrieved from your service provider dashboards.
# Values marked [GENERATED] have been created in deployment/.env.production.secrets.
# ==============================================================================

# ==============================================================================
# 1. RENDER BACKEND WEB SERVICE ENVIRONMENT VARIABLES
# Set these in: Render Dashboard -> civora-backend -> Environment
# ==============================================================================

# Application Environment Mode
NODE_ENV=production

# Server Port (Render sets PORT automatically, Express defaults to process.env.PORT)
# PORT=10000

# Vercel Frontend Production Domain (Required for CORS headers)
# Obtain from: Vercel Dashboard -> civora -> Domains
# Format: https://<your-project>.vercel.app (or custom domain https://civora.gov)
CLIENT_ORIGIN=https://YOUR_VERCEL_APP.vercel.app

# Supabase PostgreSQL Connection Pooler URL (Transaction Mode - Port 6543)
# Used by Express backend runtime for all application queries.
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Transaction)
# Format: postgresql://postgres.[PROJECT-REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.PENDING_PROJECT_REF:PENDING_DB_PASSWORD@aws-0-PENDING_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Direct PostgreSQL Connection URL (Session Mode / Direct - Port 5432)
# Required by Prisma CLI during 'prisma migrate deploy' in the build command.
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Session or Direct)
# Format: postgresql://postgres.[PROJECT-REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.PENDING_PROJECT_REF:PENDING_DB_PASSWORD@aws-0-PENDING_REGION.pooler.supabase.com:5432/postgres

# JWT Secret for Session & Authentication Tokens (Min 32 characters, 64-char hex recommended)
# Source: Copy the cryptographically secure value from deployment/.env.production.secrets
JWT_SECRET=GENERATED_IN_DEPLOYMENT_SECRETS_FILE

# JWT Token Expiration Duration
JWT_EXPIRES_IN=7d

# File Storage Configuration
# Default: local disk (mount a Persistent Disk at /opt/render/project/src/uploads on Render)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Optional: Initial Production Administrator Account (Run once via Render Shell: npm run admin:bootstrap)
# Source: Values generated in deployment/.env.production.secrets
BOOTSTRAP_ADMIN_EMAIL=admin@civora.gov
BOOTSTRAP_ADMIN_PASSWORD=GENERATED_IN_DEPLOYMENT_SECRETS_FILE
BOOTSTRAP_ADMIN_NAME=Civora Platform Administrator
BOOTSTRAP_ADMIN_PHONE=+10000000000

# ==============================================================================
# 2. VERCEL FRONTEND CONFIGURATION
# Set these in: Vercel Dashboard -> Project Settings -> Environment Variables
# (Note: Civora client proxies requests to /api via client/vercel.json rewrites)
# ==============================================================================

# If client/vercel.json rewrite is used, requests to /api/* automatically route to Render.
# If direct cross-origin API calls are desired, set VITE_API_URL:
# VITE_API_URL=https://YOUR_RENDER_SERVICE.onrender.com

# ==============================================================================
# 3. SUPABASE CONFIGURATION REFERENCE
# Set these in: Supabase Dashboard -> Project Settings
# ==============================================================================

# SUPABASE_URL=https://PENDING_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=PENDING_ANON_PUBLIC_KEY
# SUPABASE_SERVICE_ROLE_KEY=PENDING_SERVICE_ROLE_SECRET_KEY

