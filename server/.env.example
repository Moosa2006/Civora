# ==============================================================================
# CIVORA - SERVER ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# Use this template for local development or staging setup.
# Copy this file to .env and provide your local credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# HTTP port for Express backend (Default: 5000 in dev; Render sets this automatically)
PORT=5000

# Application environment: development | production | test
NODE_ENV=development

# Allowed frontend URL for Cross-Origin Resource Sharing (CORS)
# Local dev: http://localhost:5173
# Production: https://<your-project>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE CONNECTION CONFIGURATION (PostgreSQL / Supabase / Prisma)
# ------------------------------------------------------------------------------
# Application Database URL (Connection Pooler / Supavisor on Port 6543 for Supabase)
# Local: postgresql://postgres:password@localhost:5432/Cevora?schema=public
# Production (Supabase Transaction Pooler):
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# IMPORTANT: The '?pgbouncer=true' query parameter is MANDATORY for port 6543.
# It instructs Prisma to disable prepared statements, preventing PostgreSQL error 42P05
# ("prepared statement \"s0\" already exists").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/Cevora?schema=public"

# Direct Database URL for Prisma Migrations (Session mode / Port 5432)
# Prisma migrate deploy requires a direct connection that supports session-level features.
# Local: Same as DATABASE_URL
# Production (Supabase Direct):
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/Cevora?schema=public"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (min 32 characters)
# Must be a cryptographically random string in production (generated via crypto.randomBytes(32))
JWT_SECRET=your_jwt_secret_key_min_32_characters_dev

# Token validity window (e.g., 15m, 1h, 7d)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# EVIDENCE & FILE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Storage driver: 'local' (filesystem in server/uploads/evidence)
STORAGE_PROVIDER=local

# Base directory for stored files relative to server root
UPLOAD_DIR=./uploads

# Maximum upload file size in megabytes (Default: 10MB enforced in code)
MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# OPTIONAL EMAIL & NOTIFICATION SERVICE (SMTP)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_api_key
# EMAIL_FROM=notifications@civora.gov

# ------------------------------------------------------------------------------
# INITIAL ADMINISTRATOR BOOTSTRAP (Optional - for src/scripts/bootstrapAdmin.ts)
# ------------------------------------------------------------------------------
# BOOTSTRAP_ADMIN_EMAIL=admin@civora.gov
# BOOTSTRAP_ADMIN_PASSWORD=your_initial_admin_password
# BOOTSTRAP_ADMIN_NAME=Civora Platform Administrator
# BOOTSTRAP_ADMIN_PHONE=+10000000000
