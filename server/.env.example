# Civora Server Environment Configuration Template
# For production deployment, copy this file to .env and configure real credentials.
# DO NOT commit real passwords, secrets, or connection strings to source control.

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Approved Client Origin for CORS (e.g., https://civora.example.gov or http://localhost:5173 for local testing)
CLIENT_ORIGIN=http://localhost:5173

# Database Connection URL (PostgreSQL)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
DATABASE_URL=postgresql://civora_user:replace_with_secure_password@localhost:5432/civora?schema=public

# JSON Web Token (JWT) Security
# JWT_SECRET MUST be a cryptographically strong string with at least 32 characters
JWT_SECRET=replace_with_a_cryptographically_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# File Storage Configuration
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Optional Bootstrap Administrator Configuration (for npx tsx src/scripts/bootstrapAdmin.ts)
# BOOTSTRAP_ADMIN_EMAIL=admin@civora.gov
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_password
# BOOTSTRAP_ADMIN_NAME=Platform Administrator
