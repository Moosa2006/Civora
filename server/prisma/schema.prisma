  changedBy       User?            @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  reasonOrRemarks String?          @db.Text
  createdAt       DateTime         @default(now())

  @@index([complaintId])
  @@index([createdAt])
  @@map("complaint_status_history")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @db.VarChar(50)
  entityId   String   @db.Uuid
  action     String   @db.VarChar(50)
  actorId    String?  @db.Uuid
  actor      User?    @relation("UserAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)
  details    Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_events")
}

// ==========================================
// L. NOTIFICATIONS & COMMUNICATION
// ==========================================

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  user       User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
