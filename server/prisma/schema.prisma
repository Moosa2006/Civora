// Civora Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  CITIZEN
  GOVERNMENT_OFFICIAL
  ADMIN
  CONTRACTOR
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  REOPENED
  REJECTED
  CLOSED
}

enum CivicWorkStatus {
  PROPOSED
  SANCTIONED
  TENDERING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionOutcome {
  SATISFACTORY
  NEEDS_REPAIR
  WORK_REQUIRED
  RESOLVED_ON_SITE
  INVALID_COMPLAINT
}

enum FeasibilityAssessment {
  FEASIBLE
  CONDITIONALLY_FEASIBLE
  NOT_FEASIBLE
  REQUIRES_FURTHER_STUDY
}

enum EstimateStatus {
  DRAFT
  SUBMITTED
  REVISED
  APPROVED
  REJECTED
}

enum ApprovalType {
  TECHNICAL_SANCTION
  ADMINISTRATIVE_APPROVAL
  FINANCIAL_SANCTION
  WORK_ORDER_APPROVAL
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  MODIFICATIONS_REQUESTED
}

enum ContractorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum ExecutionStatus {
  AWARDED
  COMMENCED
  IN_PROGRESS
  SUBSTANTIALLY_COMPLETED
  COMPLETED
  TERMINATED
}

enum FinancialRecordType {
  BUDGET_ALLOCATION
  CONTRACTOR_PAYMENT
  EXPENSE_REIMBURSEMENT
  RETENTION_HOLD
  PENALTY_DEDUCTION
}

enum PaymentStatus {
  PLANNED
  PROCESSING
  PAID
  HELD
  FAILED
}

enum DocumentCategory {
  COMPLAINT_EVIDENCE
  INSPECTION_PHOTO
  ASSESSMENT_REPORT
  DPR_DOCUMENT
  APPROVAL_LETTER
  WORK_ORDER_COPY
  PROGRESS_PHOTO
  INVOICE_RECEIPT
  COMPLETION_CERTIFICATE
  TENDER_DOCUMENT
  BID_PROPOSAL
}

enum DocumentVisibility {
  PUBLIC
  INTERNAL_OFFICIAL
  RESTRICTED_ADMIN
}

enum TenderStatus {
  DRAFT
  PUBLISHED
  UNDER_EVALUATION
  AWARDED
  CLOSED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum WorkStartStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED_FOR_REVIEW
  APPROVED
  REJECTED_REVISION_REQUIRED
  COMPLETED
}

enum DefectStatus {
  REPORTED
  INSPECTED
  RECTIFICATION_IN_PROGRESS
  RECTIFIED_VERIFIED
  CLOSED
  DISPUTED
}

enum NotificationType {
  COMPLAINT_SUBMITTED
  STATUS_CHANGED
  DEPARTMENT_ASSIGNED
  PROGRESS_UPDATE
  RESOLUTION_SUBMITTED
  RESOLUTION_VERIFIED
  COMPLAINT_REOPENED
  MESSAGE_RECEIVED
  PROJECT_UPDATE
  SYSTEM_ALERT
  PROPOSAL_SUBMITTED
  PROPOSAL_STATUS_CHANGED
  PROPOSAL_RESPONSE
  POLL_CREATED
  SLA_WARNING
  SLA_BREACH
  ESCALATION_TRIGGERED
  ESCALATION_ACKNOWLEDGED
  SLA_EXTENSION_REQUESTED
  SLA_EXTENSION_DECIDED
  EVIDENCE_UPLOADED
  EVIDENCE_APPROVED
  EVIDENCE_REJECTED
  EVIDENCE_RESUBMISSION_REQUESTED
  RESOLUTION_PROOF_SUBMITTED
  RESOLUTION_PROOF_VERIFIED
  RESOLUTION_PROOF_REJECTED
  MODERATION_WARNING
  CONTENT_MODERATED
  ACCOUNT_RESTRICTED
  RESTRICTION_LIFTED
  APPEAL_DECISION
  TENDER_PUBLISHED
  BID_SUBMITTED
  BID_EVALUATED
  CONTRACT_AWARDED
  WORK_START_SUBMITTED
  WORK_START_VERIFIED
  MILESTONE_CLAIMED
  MILESTONE_APPROVED
  MILESTONE_REJECTED
  PAYMENT_RECORDED
  DEFECT_REPORTED
  DEFECT_RECTIFIED
}

enum AbuseReportReason {
  SPAM
  HARASSMENT
  PERSONAL_DATA_EXPOSURE
  IMPERSONATION
  MALICIOUS_OR_SUSPICIOUS
  MISINFORMATION
  OTHER
}

enum AbuseReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED_ACTION_TAKEN
  RESOLVED_NO_VIOLATION
  DISMISSED
}

enum ReportTargetType {
  COMPLAINT
  COMPLAINT_MESSAGE
  PROPOSAL
  PROPOSAL_COMMENT
  POLL
  DOCUMENT
}

enum ModerationCaseStatus {
  OPEN
  UNDER_REVIEW
  ACTION_TAKEN
  RESOLVED_NO_VIOLATION
  CLOSED
}

enum ModerationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ModerationActionType {
  NO_ACTION
  WARNING_ISSUED
  CONTENT_HIDDEN
  CONTENT_REMOVED
  CONTENT_RESTORED
  ACCOUNT_RESTRICTED
  DUPLICATE_LINKED
}

enum AppealStatus {
  PENDING
  UNDER_REVIEW
  UPHELD
  REJECTED
}

enum UserRestrictionType {
  SUBMISSION_RESTRICTED
  COMMENTING_RESTRICTED
  UPLOAD_RESTRICTED
  ACCOUNT_SUSPENDED
}

enum ProposalStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CLARIFICATION
  PUBLISHED
  ACCEPTED_FOR_CONSIDERATION
  DECLINED
  ARCHIVED
}

enum PollStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  ARCHIVED
}

enum PollType {
  SINGLE_CHOICE
  MULTI_CHOICE
}

enum PollVisibilityRule {
  ALWAYS_VISIBLE
  AFTER_VOTE
  AFTER_CLOSE
}

enum SlaStatus {
  ON_TRACK
  APPROACHING_DEADLINE
  RESPONSE_OVERDUE
  RESOLUTION_OVERDUE
  BREACHED
  RESOLVED_ON_TIME
  RESOLVED_LATE
  NO_SLA
}

enum EscalationLevel {
  LEVEL_1_OFFICIAL
  LEVEL_2_SUPERVISOR
  LEVEL_3_HEAD_ADMIN
}

enum EscalationStatus {
  ACTIVE
  ACKNOWLEDGED
  ACTION_PLANNED
  RESOLVED
  DE_ESCALATED
}

enum EscalationTrigger {
  RESPONSE_DEADLINE_MISSED
  RESOLUTION_DEADLINE_MISSED
  OVERDUE_GRACE_EXCEEDED
  MANUAL_SUPERVISOR_ESCALATION
  REPEATED_BREACH
}

enum ExtensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EvidencePurpose {
  CITIZEN_SUPPORTING
  OFFICIAL_PROGRESS
  RESOLUTION_PROOF
  ADMINISTRATIVE_REVIEW
}

enum EvidenceReviewStatus {
  PENDING_REVIEW
  UNDER_REVIEW
  VERIFIED
  REJECTED
  RESUBMISSION_REQUESTED
  QUARANTINED
}

// ==========================================
// CORE MASTER TABLES
// ==========================================

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  officials           User[]              @relation("DepartmentOfficials")
  complaintCategories ComplaintCategory[]
  assignedComplaints  Complaint[]         @relation("DepartmentComplaints")
  civicWorks          CivicWork[]
  escalatedComplaints ComplaintEscalation[] @relation("DepartmentEscalations")
  tenders             Tender[]

  @@map("departments")
}

model ComplaintCategory {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique @db.VarChar(50)
  name         String     @db.VarChar(255)
  description  String?    @db.Text
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  complaints  Complaint[]
  proposals   CommunityProposal[]
  polls       PublicPoll[]
  slaPolicies SlaPolicy[]

  @@index([departmentId])
  @@map("complaint_categories")
}

// ==========================================
// A. USERS
// ==========================================

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(255)
  name            String        @db.VarChar(255)
  phone           String?       @db.VarChar(50)
  passwordHash    String        @db.VarChar(255)
  role            UserRole      @default(CITIZEN)
  accountStatus   AccountStatus @default(ACTIVE)
  departmentId    String?       @db.Uuid
  department      Department?   @relation("DepartmentOfficials", fields: [departmentId], references: [id], onDelete: SetNull)
  contractorId    String?       @db.Uuid
  contractor      Contractor?   @relation("ContractorUsers", fields: [contractorId], references: [id], onDelete: SetNull)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  submittedComplaints      Complaint[]                @relation("CitizenComplaints")
  assignedComplaints       Complaint[]                @relation("OfficialComplaints")
  inspections              SiteInspection[]           @relation("InspectorInspections")
  technicalAssessments     TechnicalAssessment[]      @relation("AssessorAssessments")
  preparedEstimates        Estimate[]                 @relation("EstimatePreparer")
  sanctionDecisions        ApprovalSanction[]         @relation("ApproverSanctions")
  progressUpdatesLogged    ExecutionProgressUpdate[]  @relation("LoggedProgressUpdates")
  uploadedDocuments        Document[]                 @relation("UploadedDocuments")
  statusHistoryChanges     ComplaintStatusHistory[]   @relation("StatusChangedBy")
  auditEvents              AuditEvent[]               @relation("UserAuditEvents")
  notifications            Notification[]             @relation("UserNotifications")
  notificationPref         NotificationPreference?    @relation("UserNotificationPreferences")
  sentComplaintMessages    ComplaintMessage[]         @relation("SentComplaintMessages")
  submittedProposals       CommunityProposal[]        @relation("CitizenProposals")
  moderatedProposals       CommunityProposal[]        @relation("ModeratedProposals")
  respondedProposals       CommunityProposal[]        @relation("OfficialResponseProposals")
  proposalSupports         ProposalSupport[]          @relation("UserProposalSupports")
  proposalComments         ProposalComment[]          @relation("UserProposalComments")
  createdPolls             PublicPoll[]               @relation("UserCreatedPolls")
  pollVotes                PollVote[]                 @relation("UserPollVotes")
  pollParticipations       PollParticipation[]        @relation("UserPollParticipations")
  createdSlaPolicies       SlaPolicy[]                @relation("CreatedSlaPolicies")
  updatedSlaPolicies       SlaPolicy[]                @relation("UpdatedSlaPolicies")
  escalationsAssigned      ComplaintEscalation[]      @relation("EscalatedToOfficial")
  escalationsCreated       ComplaintEscalation[]      @relation("EscalatedBy")
  escalationsAcknowledged  ComplaintEscalation[]      @relation("EscalationAcknowledgedBy")
  escalationActionPlans    ComplaintEscalation[]      @relation("EscalationActionPlanBy")
  escalationsResolved      ComplaintEscalation[]      @relation("EscalationResolvedBy")
  escalationActionLogs     EscalationActionLog[]      @relation("UserEscalationLogs")
  requestedSlaExtensions   SlaExtensionRequest[]      @relation("RequestedSlaExtensions")
  decidedSlaExtensions     SlaExtensionRequest[]      @relation("DecidedSlaExtensions")
  reviewedDocuments        Document[]                 @relation("ReviewedDocuments")
  evidenceReviewLogs       EvidenceReviewLog[]        @relation("UserEvidenceReviewLogs")
  reportedAbuse            AbuseReport[]              @relation("UserReportedAbuse")
  assignedAbuseReports     AbuseReport[]              @relation("AssignedAbuseReports")
  assignedModerationCases  ModerationCase[]           @relation("AssignedModerationCases")
  targetedModerationCases  ModerationCase[]           @relation("TargetedModerationCases")
  moderationActions        ModerationAction[]         @relation("UserModerationActions")
  moderationAppeals        ModerationAppeal[]         @relation("UserAppeals")
  reviewedAppeals          ModerationAppeal[]         @relation("ReviewedAppeals")
  userRestrictions         UserRestriction[]          @relation("TargetUserRestrictions")
  createdRestrictions      UserRestriction[]          @relation("CreatedUserRestrictions")
  liftedRestrictions       UserRestriction[]          @relation("LiftedUserRestrictions")
  linkedDuplicates         ComplaintDuplicateLink[]   @relation("UserLinkedDuplicates")
  accessibilityPref        UserAccessibilityPreference? @relation("UserAccessibilityPreferences")
  updatedPlatformSettings  PlatformSetting[]          @relation("UpdatedPlatformSettings")
  configChanges            ConfigurationChangeLog[]   @relation("UserConfigChanges")
  reportedIncidents        OperationalIncident[]      @relation("ReportedIncidents")
  assignedIncidents        OperationalIncident[]      @relation("AssignedIncidents")
  resolvedIncidents        OperationalIncident[]      @relation("ResolvedIncidents")

  // Module 17: Contractor & Tendering Relationships
  createdTenders           Tender[]                   @relation("CreatedTenders")
  submittedBids            TenderBid[]                @relation("SubmittedBids")
  evaluatedBids            TenderBid[]                @relation("EvaluatedBids")
  submittedWorkStarts      WorkStartDeclaration[]     @relation("SubmittedWorkStarts")
  verifiedWorkStarts       WorkStartDeclaration[]     @relation("VerifiedWorkStarts")
  claimedMilestones        ContractMilestone[]        @relation("ClaimedMilestones")
  reviewedMilestones       ContractMilestone[]        @relation("ReviewedMilestones")
  reportedDefects          DefectWarrantyRequest[]    @relation("ReportedDefects")
  verifiedDefects          DefectWarrantyRequest[]    @relation("VerifiedDefects")
  verifiedContractors      Contractor[]               @relation("VerifiedContractors")

  @@index([role])
  @@index([departmentId])
  @@index([contractorId])
  @@map("users")
}

// ==========================================
// B. COMPLAINTS
// ==========================================

model Complaint {
  id                   String            @id @default(uuid()) @db.Uuid
  trackingId           String            @unique @db.VarChar(32)
  title                String            @db.VarChar(255)
  description          String            @db.Text
  categoryId           String            @db.Uuid
  category             ComplaintCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priority             ComplaintPriority @default(MEDIUM)
  status               ComplaintStatus   @default(SUBMITTED)
  citizenId            String?           @db.Uuid
  citizen              User?             @relation("CitizenComplaints", fields: [citizenId], references: [id], onDelete: SetNull)
  assignedDepartmentId String?           @db.Uuid
  assignedDepartment   Department?       @relation("DepartmentComplaints", fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  assignedOfficialId   String?           @db.Uuid
  assignedOfficial     User?             @relation("OfficialComplaints", fields: [assignedOfficialId], references: [id], onDelete: SetNull)
  locationAddress      String            @db.Text
  locality             String            @db.VarChar(255)
  ward                 String?           @db.VarChar(100)
  latitude             Decimal?          @db.Decimal(10, 7)
  longitude            Decimal?          @db.Decimal(10, 7)
  locationSource       String?           @db.VarChar(50)
  locationAccuracy     Float?
  isLocationPublic     Boolean           @default(true)
  rejectionReason      String?           @db.Text
  resolutionNotes      String?           @db.Text
  reviewedAt           DateTime?
  assignedAt           DateTime?
  resolvedAt           DateTime?
  verifiedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relationships
  statusHistory       ComplaintStatusHistory[]
  civicWorkLinks      CivicWorkComplaint[]
  inspections         SiteInspection[]
  assessments         TechnicalAssessment[]
  documents           Document[]
  messages            ComplaintMessage[]         @relation("ComplaintMessages")
  sla                 ComplaintSla?
  escalations         ComplaintEscalation[]
  extensionRequests   SlaExtensionRequest[]

  // Module 14: Moderation & Duplicate Linking
  isModerated           Boolean                    @default(false)
  moderationReason      String?                    @db.Text
  primaryDuplicateLinks ComplaintDuplicateLink[]   @relation("PrimaryComplaintDuplicates")
  duplicateLinks        ComplaintDuplicateLink[]   @relation("DuplicateComplaintLinks")

  // Module 18: AI Verification, Duplicate & Fraud Detection
  aiAnalysisStatus      String?                    @default("PENDING") @db.VarChar(32)
  aiRiskLevel           String?                    @db.VarChar(32)
  aiRiskScore           Int?                       @default(0)
  aiFindings            Json?
  aiAnalyzedAt          DateTime?
  isDuplicate           Boolean                    @default(false)
  duplicateConfidence   Float?
  primaryComplaintId    String?                    @db.Uuid
  primaryComplaint      Complaint?                 @relation("ComplaintHierarchy", fields: [primaryComplaintId], references: [id], onDelete: SetNull)
  subordinateComplaints Complaint[]                @relation("ComplaintHierarchy")

  @@index([trackingId])
  @@index([status])
  @@index([categoryId])
  @@index([citizenId])
  @@index([assignedDepartmentId])
  @@index([assignedOfficialId])
  @@index([createdAt])
  @@index([locality])
  @@index([ward])
  @@index([latitude, longitude])
  @@index([isLocationPublic])
  @@index([aiAnalysisStatus])
  @@index([aiRiskLevel])
  @@index([isDuplicate])
  @@index([primaryComplaintId])
  @@map("complaints")
}

// ==========================================
// C. PROJECTS / CIVIC WORKS
// ==========================================

model CivicWork {
  id                   String          @id @default(uuid()) @db.Uuid
  workOrderNumber      String          @unique @db.VarChar(64)
  title                String          @db.VarChar(255)
  description          String          @db.Text
  workType             String          @db.VarChar(100)
  departmentId         String          @db.Uuid
  department           Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  location             String          @db.VarChar(255)
  ward                 String?         @db.VarChar(100)
  estimatedBudget      Decimal         @db.Decimal(14, 2)
  sanctionedAmount     Decimal?        @db.Decimal(14, 2)
  plannedStartDate     DateTime?
  plannedEndDate       DateTime?
  actualStartDate      DateTime?
  actualCompletionDate DateTime?
  workStatus           CivicWorkStatus @default(PROPOSED)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Relationships
  complaintLinks       CivicWorkComplaint[]
  inspections          SiteInspection[]
  assessments          TechnicalAssessment[]
  estimates            Estimate[]
  approvals            ApprovalSanction[]
  workOrders           WorkOrder[]
  financialRecords     FinancialTransaction[]
  tenders              Tender[]

  @@index([workOrderNumber])
  @@index([departmentId])
  @@index([workStatus])
  @@map("civic_works")
}

// Association Table between Civic Works and Complaints (M:N)
model CivicWorkComplaint {
  id          String     @id @default(uuid()) @db.Uuid
  civicWorkId String     @db.Uuid
  civicWork   CivicWork  @relation(fields: [civicWorkId], references: [id], onDelete: Cascade)
  complaintId String     @db.Uuid
  complaint   Complaint  @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  linkedAt    DateTime   @default(now())
  notes       String?    @db.Text

  @@unique([civicWorkId, complaintId])
  @@index([civicWorkId])
  @@index([complaintId])
  @@map("civic_work_complaints")
}

// ==========================================
// D. SITE INSPECTIONS
// ==========================================

model SiteInspection {
  id              String            @id @default(uuid()) @db.Uuid
  complaintId     String?           @db.Uuid
  complaint       Complaint?        @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  civicWorkId     String?           @db.Uuid
  civicWork       CivicWork?        @relation(fields: [civicWorkId], references: [id], onDelete: SetNull)
  inspectorId     String            @db.Uuid
  inspector       User              @relation("InspectorInspections", fields: [inspectorId], references: [id], onDelete: Restrict)
  inspectionDate  DateTime          @default(now())
  outcome         InspectionOutcome
  observations    String            @db.Text
  measurements    String?           @db.Text
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  documents       Document[]

  @@index([complaintId])
  @@index([civicWorkId])
  @@index([inspectorId])
  @@map("site_inspections")
}

// ==========================================
// E. TECHNICAL ASSESSMENTS
// ==========================================

model TechnicalAssessment {
  id                String                @id @default(uuid()) @db.Uuid
  complaintId       String?               @db.Uuid
  complaint         Complaint?            @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  civicWorkId       String?               @db.Uuid
  civicWork         CivicWork?            @relation(fields: [civicWorkId], references: [id], onDelete: SetNull)
  assessorId        String                @db.Uuid
  assessor          User                  @relation("AssessorAssessments", fields: [assessorId], references: [id], onDelete: Restrict)
  assessmentDate    DateTime              @default(now())
  technicalFindings String                @db.Text
  requiredWork      String                @db.Text
  estimatedScope    String?               @db.Text
  feasibility       FeasibilityAssessment @default(FEASIBLE)
  recommendation    String                @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  documents         Document[]

  @@index([complaintId])
  @@index([civicWorkId])
  @@index([assessorId])
  @@map("technical_assessments")
}

// ==========================================
// F. ESTIMATES & DETAILED PROJECT REPORTS
// ==========================================

model Estimate {
  id              String             @id @default(uuid()) @db.Uuid
  estimateNumber  String             @unique @db.VarChar(64)
  civicWorkId     String             @db.Uuid
  civicWork       CivicWork          @relation(fields: [civicWorkId], references: [id], onDelete: Restrict)
  version         Int                @default(1)
  preparedById    String             @db.Uuid
  preparedBy      User               @relation("EstimatePreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  preparationDate DateTime           @default(now())
  description     String             @db.Text
  status          EstimateStatus     @default(DRAFT)
  totalAmount     Decimal            @db.Decimal(14, 2)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  lineItems       EstimateLineItem[]
  approvals       ApprovalSanction[]
  documents       Document[]

  @@unique([civicWorkId, version])
  @@index([estimateNumber])
  @@index([civicWorkId])
  @@index([preparedById])
  @@map("estimates")
}

model EstimateLineItem {
  id                String   @id @default(uuid()) @db.Uuid
  estimateId        String   @db.Uuid
  estimate          Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  itemNumber        Int
  description       String   @db.VarChar(500)
  quantity          Decimal  @db.Decimal(10, 2)
  unitOfMeasurement String   @db.VarChar(50)
  unitRate          Decimal  @db.Decimal(12, 2)
  totalAmount       Decimal  @db.Decimal(14, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([estimateId, itemNumber])
  @@index([estimateId])
  @@map("estimate_line_items")
}

// ==========================================
// G. APPROVALS / SANCTIONS
// ==========================================

model ApprovalSanction {
  id               String           @id @default(uuid()) @db.Uuid
  referenceNumber  String?          @unique @db.VarChar(64)
  civicWorkId      String           @db.Uuid
  civicWork        CivicWork        @relation(fields: [civicWorkId], references: [id], onDelete: Restrict)
  estimateId       String?          @db.Uuid
  estimate         Estimate?        @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  approvalType     ApprovalType
  approverId       String           @db.Uuid
  approver         User             @relation("ApproverSanctions", fields: [approverId], references: [id], onDelete: Restrict)
  decision         ApprovalDecision @default(PENDING)
  decisionDate     DateTime?
  sanctionedAmount Decimal?         @db.Decimal(14, 2)
  remarks          String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  documents        Document[]

  @@index([civicWorkId])
  @@index([estimateId])
  @@index([approverId])
  @@index([decision])
  @@map("approval_sanctions")
}

// ==========================================
// H. CONTRACTORS & EXECUTION
// ==========================================

model Contractor {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String           @db.VarChar(255)
  registrationNumber String?          @unique @db.VarChar(100)
  contactPerson      String?          @db.VarChar(255)
  email              String?          @db.VarChar(255)
  phone              String?          @db.VarChar(50)
  status             ContractorStatus @default(ACTIVE)
  businessAddress    String?          @db.Text
  operatingRegion    String?          @db.VarChar(255)
  licenseClass       String?          @default("CLASS_B") @db.VarChar(50)
  panOrTaxId         String?          @db.VarChar(50)
  workCategories     String[]         @default([])
  isVerified         Boolean          @default(false)
  verifiedAt         DateTime?
  verifiedById       String?          @db.Uuid
  verifiedBy         User?            @relation("VerifiedContractors", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  users                 User[]                  @relation("ContractorUsers")
  workOrders            WorkOrder[]
  bids                  TenderBid[]
  workStartDeclarations WorkStartDeclaration[]
  defects               DefectWarrantyRequest[]
  financialTransactions FinancialTransaction[]

  @@map("contractors")
}

model WorkOrder {
  id                   String          @id @default(uuid()) @db.Uuid
  workOrderNumber      String          @unique @db.VarChar(64)
  civicWorkId          String          @db.Uuid
  civicWork            CivicWork       @relation(fields: [civicWorkId], references: [id], onDelete: Restrict)
  contractorId         String          @db.Uuid
  contractor           Contractor      @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  tenderId             String?         @db.Uuid
  tender               Tender?         @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  tenderBidId          String?         @unique @db.Uuid
  tenderBid            TenderBid?      @relation(fields: [tenderBidId], references: [id], onDelete: SetNull)
  workOrderDate        DateTime        @default(now())
  contractAmount       Decimal         @db.Decimal(14, 2)
  startDate            DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate DateTime?
  executionStatus      ExecutionStatus @default(AWARDED)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  progressUpdates       ExecutionProgressUpdate[]
  workStartDeclarations WorkStartDeclaration[]
  milestones            ContractMilestone[]
  defects               DefectWarrantyRequest[]
  financialTransactions FinancialTransaction[]   @relation("WorkOrderFinancials")

  @@index([civicWorkId])
  @@index([contractorId])
  @@index([executionStatus])
  @@index([tenderId])
  @@map("work_orders")
}

model ExecutionProgressUpdate {
  id                         String    @id @default(uuid()) @db.Uuid
  workOrderId                String    @db.Uuid
  workOrder                  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  loggedById                 String    @db.Uuid
  loggedBy                   User      @relation("LoggedProgressUpdates", fields: [loggedById], references: [id], onDelete: Restrict)
  updateDate                 DateTime  @default(now())
  physicalProgressPercentage Decimal   @db.Decimal(5, 2)
  financialProgressAmount    Decimal?  @db.Decimal(14, 2)
  progressNotes              String    @db.Text
  milestoneReached           String?   @db.VarChar(255)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  documents Document[]

  @@index([workOrderId])
  @@index([loggedById])
  @@map("execution_progress_updates")
}

// ==========================================
// I. FINANCIAL RECORDS
// ==========================================

model FinancialTransaction {
  id               String               @id @default(uuid()) @db.Uuid
  civicWorkId      String               @db.Uuid
  civicWork        CivicWork            @relation(fields: [civicWorkId], references: [id], onDelete: Restrict)
  workOrderId      String?              @db.Uuid
  workOrder        WorkOrder?           @relation("WorkOrderFinancials", fields: [workOrderId], references: [id], onDelete: SetNull)
  contractorId     String?              @db.Uuid
  contractor       Contractor?          @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  recordType       FinancialRecordType
  amount           Decimal              @db.Decimal(14, 2)
  paymentDate      DateTime?
  paymentReference String?              @db.VarChar(100)
  paymentStatus    PaymentStatus        @default(PLANNED)
  remarks          String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  documents Document[]

  @@index([civicWorkId])
  @@index([workOrderId])
  @@index([contractorId])
  @@index([recordType])
  @@index([paymentStatus])
  @@map("financial_transactions")
}

// ==========================================
// J. DOCUMENTS / MEDIA METADATA
// ==========================================

model Document {
  id                     String                   @id @default(uuid()) @db.Uuid
  fileName               String                   @db.VarChar(255)
  storageKey             String                   @db.VarChar(500)
  mimeType               String                   @db.VarChar(100)
  fileSize               BigInt
  documentCategory       DocumentCategory
  uploaderId             String?                  @db.Uuid
  uploader               User?                    @relation("UploadedDocuments", fields: [uploaderId], references: [id], onDelete: SetNull)
  visibility             DocumentVisibility       @default(PUBLIC)
  description            String?                  @db.Text

  // Explicit referential integrity relations
  complaintId            String?                  @db.Uuid
  complaint              Complaint?               @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  siteInspectionId       String?                  @db.Uuid
  siteInspection         SiteInspection?          @relation(fields: [siteInspectionId], references: [id], onDelete: Cascade)
  technicalAssessmentId  String?                  @db.Uuid
  technicalAssessment    TechnicalAssessment?     @relation(fields: [technicalAssessmentId], references: [id], onDelete: Cascade)
  estimateId             String?                  @db.Uuid
  estimate               Estimate?                @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  approvalSanctionId     String?                  @db.Uuid
  approvalSanction       ApprovalSanction?        @relation(fields: [approvalSanctionId], references: [id], onDelete: Cascade)
  progressUpdateId       String?                  @db.Uuid
  progressUpdate         ExecutionProgressUpdate? @relation(fields: [progressUpdateId], references: [id], onDelete: Cascade)
  financialTransactionId String?                  @db.Uuid
  financialTransaction   FinancialTransaction?    @relation(fields: [financialTransactionId], references: [id], onDelete: Cascade)

  // Module 17: Tender & Execution Relations
  tenderId               String?                  @db.Uuid
  tender                 Tender?                  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  tenderBidId            String?                  @db.Uuid
  tenderBid              TenderBid?               @relation(fields: [tenderBidId], references: [id], onDelete: Cascade)
  workStartId            String?                  @db.Uuid
  workStart              WorkStartDeclaration?    @relation(fields: [workStartId], references: [id], onDelete: Cascade)
  milestoneId            String?                  @db.Uuid
  milestone              ContractMilestone?       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  defectRequestId        String?                  @db.Uuid
  defectRequest          DefectWarrantyRequest?   @relation(fields: [defectRequestId], references: [id], onDelete: Cascade)

  uploadTimestamp        DateTime                 @default(now())
  createdAt              DateTime                 @default(now())

  // Module 12: Evidence Purpose, Verification & Review Tracking
  evidencePurpose        EvidencePurpose          @default(CITIZEN_SUPPORTING)
  reviewStatus           EvidenceReviewStatus     @default(PENDING_REVIEW)
  sha256Checksum         String?                  @db.VarChar(64)
  reviewedById           String?                  @db.Uuid
  reviewedBy             User?                    @relation("ReviewedDocuments", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  reviewNotes            String?                  @db.Text
  rejectionReason        String?                  @db.Text
  resubmissionGuidance   String?                  @db.Text
  replacedDocumentId     String?                  @db.Uuid
  replacedDocument       Document?                @relation("DocumentReplacements", fields: [replacedDocumentId], references: [id], onDelete: SetNull)
  replacementDocuments   Document[]               @relation("DocumentReplacements")
  isQuarantined          Boolean                  @default(false)
  quarantineReason       String?                  @db.Text

  // Image Capture Time, Location & Perceptual Hashing
  perceptualHash          String?                  @db.VarChar(64)
  capturedAt              DateTime?
  captureLatitude         Decimal?                 @db.Decimal(10, 7)
  captureLongitude        Decimal?                 @db.Decimal(10, 7)
  captureAccuracy         Float?
  isGpsVerified           Boolean                  @default(false)
  browserCaptureTimestamp DateTime?

  reviewLogs             EvidenceReviewLog[]

  @@index([complaintId])
  @@index([siteInspectionId])
  @@index([technicalAssessmentId])
  @@index([estimateId])
  @@index([approvalSanctionId])
  @@index([progressUpdateId])
  @@index([financialTransactionId])
  @@index([tenderId])
  @@index([tenderBidId])
  @@index([workStartId])
  @@index([milestoneId])
  @@index([defectRequestId])
  @@index([documentCategory])
  @@index([visibility])
  @@index([reviewStatus])
  @@index([evidencePurpose])
  @@index([reviewedById])
  @@index([isQuarantined])
  @@index([sha256Checksum])
  @@index([perceptualHash])
  @@map("documents")
}

model EvidenceReviewLog {
  id              String                @id @default(uuid()) @db.Uuid
  documentId      String                @db.Uuid
  document        Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId      String?               @db.Uuid
  reviewer        User?                 @relation("UserEvidenceReviewLogs", fields: [reviewerId], references: [id], onDelete: SetNull)
  fromStatus      EvidenceReviewStatus?
  toStatus        EvidenceReviewStatus
  decisionReason  String?               @db.Text
  guidance        String?               @db.Text
  createdAt       DateTime              @default(now())

  @@index([documentId])
  @@index([reviewerId])
  @@index([createdAt])
  @@map("evidence_review_logs")
}

// ==========================================
// K. AUDIT & STATUS HISTORY (APPEND-ONLY)
// ==========================================

model ComplaintStatusHistory {
  id              String           @id @default(uuid()) @db.Uuid
  complaintId     String           @db.Uuid
