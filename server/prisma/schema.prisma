  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  user                 User     @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications   Boolean  @default(false)
  statusChangeAlerts   Boolean  @default(true)
  progressUpdateAlerts Boolean  @default(true)
  assignmentAlerts     Boolean  @default(true)
  messageAlerts        Boolean  @default(true)
  resolutionAlerts     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("notification_preferences")
}

model UserAccessibilityPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  user          User     @relation("UserAccessibilityPreferences", fields: [userId], references: [id], onDelete: Cascade)
  language      String   @default("en") @db.VarChar(10)
  textSize      String   @default("normal") @db.VarChar(20)
  reducedMotion Boolean  @default(false)
  highContrast  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_accessibility_preferences")
}

model ComplaintMessage {
  id          String    @id @default(uuid()) @db.Uuid
  complaintId String    @db.Uuid
  complaint   Complaint @relation("ComplaintMessages", fields: [complaintId], references: [id], onDelete: Cascade)
  senderId    String    @db.Uuid
  sender      User      @relation("SentComplaintMessages", fields: [senderId], references: [id], onDelete: Cascade)
  message     String    @db.Text
  isInternal  Boolean   @default(false)
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  // Module 14: Moderation
  isModerated      Boolean   @default(false)
  moderationReason String?   @db.VarChar(255)

  @@index([complaintId, createdAt])
  @@index([senderId])
  @@map("complaint_messages")
}

// ==========================================
// M. CIVIC ENGAGEMENT, PROPOSALS & POLLS
// ==========================================

model CommunityProposal {
  id                      String            @id @default(uuid()) @db.Uuid
  trackingId              String            @unique @db.VarChar(32)
  title                   String            @db.VarChar(255)
  description             String            @db.Text
  problemStatement        String?           @db.Text
  suggestedSolution       String?           @db.Text
  categoryId              String            @db.Uuid
  category                ComplaintCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  locality                String?           @db.VarChar(255)
  status                  ProposalStatus    @default(SUBMITTED)
  submitterId             String            @db.Uuid
  submitter               User              @relation("CitizenProposals", fields: [submitterId], references: [id], onDelete: Cascade)
  moderatedById           String?           @db.Uuid
  moderatedBy             User?             @relation("ModeratedProposals", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt             DateTime?
  internalModerationNotes String?           @db.Text
  publicExplanation       String?           @db.Text
  officialResponse        String?           @db.Text
  officialResponseById    String?           @db.Uuid
  officialResponseBy      User?             @relation("OfficialResponseProposals", fields: [officialResponseById], references: [id], onDelete: SetNull)
  officialResponseAt      DateTime?
  supportCount            Int               @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  supports                ProposalSupport[]
  comments                ProposalComment[]

  // Module 14: Moderation flag
  isModerated             Boolean           @default(false)

  @@index([status])
  @@index([categoryId])
  @@index([submitterId])
  @@index([createdAt])
  @@map("community_proposals")
}

model ProposalSupport {
  id         String            @id @default(uuid()) @db.Uuid
  proposalId String            @db.Uuid
  proposal   CommunityProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String            @db.Uuid
  user       User              @relation("UserProposalSupports", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@unique([proposalId, userId])
  @@index([proposalId])
  @@index([userId])
  @@map("proposal_supports")
}

model ProposalComment {
  id               String            @id @default(uuid()) @db.Uuid
  proposalId       String            @db.Uuid
  proposal         CommunityProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  authorId         String            @db.Uuid
  author           User              @relation("UserProposalComments", fields: [authorId], references: [id], onDelete: Cascade)
  content          String            @db.Text
  isModerated      Boolean           @default(false)
  moderationReason String?           @db.VarChar(255)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([proposalId, createdAt])
  @@index([authorId])
  @@map("proposal_comments")
}

model PublicPoll {
  id             String             @id @default(uuid()) @db.Uuid
  title          String             @db.VarChar(255)
  question       String             @db.VarChar(500)
  description    String?            @db.Text
  categoryId     String?            @db.Uuid
  category       ComplaintCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  locality       String?            @db.VarChar(255)
  status         PollStatus         @default(DRAFT)
  pollType       PollType           @default(SINGLE_CHOICE)
  maxSelections  Int                @default(1)
  visibilityRule PollVisibilityRule @default(ALWAYS_VISIBLE)
  startDate      DateTime
  endDate        DateTime
  isAdvisory     Boolean            @default(true)
  createdById    String?            @db.Uuid
  createdBy      User?              @relation("UserCreatedPolls", fields: [createdById], references: [id], onDelete: SetNull)
  totalVotes     Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  options        PollOption[]
  votes          PollVote[]
  participations PollParticipation[]

  @@index([status])
  @@index([startDate, endDate])
  @@index([categoryId])
  @@map("public_polls")
}

model PollOption {
  id         String     @id @default(uuid()) @db.Uuid
  pollId     String     @db.Uuid
  poll       PublicPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text       String     @db.VarChar(255)
  orderIndex Int        @default(0)
  voteCount  Int        @default(0)
  createdAt  DateTime   @default(now())

  votes      PollVote[]

  @@index([pollId, orderIndex])
  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(uuid()) @db.Uuid
  pollId    String     @db.Uuid
  poll      PublicPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String     @db.Uuid
  user      User       @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)
  optionId  String     @db.Uuid
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([userId])
  @@index([optionId])
  @@map("poll_votes")
}

model PollParticipation {
  id        String     @id @default(uuid()) @db.Uuid
  pollId    String     @db.Uuid
  poll      PublicPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String     @db.Uuid
  user      User       @relation("UserPollParticipations", fields: [userId], references: [id], onDelete: Cascade)
  votedAt   DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
  @@map("poll_participations")
}

// ==========================================
// N. SERVICE-LEVEL AGREEMENTS (SLAs) & ESCALATIONS
// ==========================================

model SlaPolicy {
  id                       String             @id @default(uuid()) @db.Uuid
  name                     String             @db.VarChar(255)
  description              String?            @db.Text
  categoryId               String?            @db.Uuid
  category                 ComplaintCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priority                 ComplaintPriority?
  responseTargetHours      Int                @default(24)
  resolutionTargetHours    Int                @default(72)
  warningThresholdHours    Int                @default(12)
  escalationThresholdHours Int                @default(24)
  isActive                 Boolean            @default(true)
  isDefault                Boolean            @default(false)
  effectiveStartDate       DateTime           @default(now())
  effectiveEndDate         DateTime?
  createdById              String?            @db.Uuid
  createdBy                User?              @relation("CreatedSlaPolicies", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById              String?            @db.Uuid
  updatedBy                User?              @relation("UpdatedSlaPolicies", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  complaintSlas            ComplaintSla[]

  @@index([categoryId])
  @@index([priority])
  @@index([isActive])
  @@index([isDefault])
  @@map("sla_policies")
}

model ComplaintSla {
  id                          String                @id @default(uuid()) @db.Uuid
  complaintId                 String                @unique @db.Uuid
  complaint                   Complaint             @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  policyId                    String?               @db.Uuid
  policy                      SlaPolicy?            @relation(fields: [policyId], references: [id], onDelete: SetNull)
  policyName                  String                @db.VarChar(255)
  responseTargetHours         Int
  resolutionTargetHours       Int
  clockStartedAt              DateTime              @default(now())
  originalResponseDeadline    DateTime
  originalResolutionDeadline  DateTime
  currentResponseDeadline     DateTime
  currentResolutionDeadline   DateTime
  respondedAt                 DateTime?
  isResponseOverdue           Boolean               @default(false)
  isResolutionOverdue         Boolean               @default(false)
  slaStatus                   SlaStatus             @default(ON_TRACK)
  estimatedCompletionDate     DateTime?
  estimatedCompletionNotes    String?               @db.Text
  warningSentAt               DateTime?
  breachNotificationSentAt    DateTime?
  lastEvaluatedAt             DateTime              @default(now())
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  extensionRequests           SlaExtensionRequest[]

  @@index([slaStatus])
  @@index([currentResolutionDeadline])
  @@index([currentResponseDeadline])
  @@index([isResolutionOverdue])
  @@map("complaint_slas")
}

model ComplaintEscalation {
  id                      String              @id @default(uuid()) @db.Uuid
  complaintId             String              @db.Uuid
  complaint               Complaint           @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  escalationLevel         EscalationLevel     @default(LEVEL_1_OFFICIAL)
  triggerReason           EscalationTrigger
  notes                   String              @db.Text
  status                  EscalationStatus    @default(ACTIVE)
  escalatedToDepartmentId String?             @db.Uuid
  escalatedToDepartment   Department?         @relation("DepartmentEscalations", fields: [escalatedToDepartmentId], references: [id], onDelete: SetNull)
  escalatedToOfficialId   String?             @db.Uuid
  escalatedToOfficial     User?               @relation("EscalatedToOfficial", fields: [escalatedToOfficialId], references: [id], onDelete: SetNull)
  escalatedById           String?             @db.Uuid
  escalatedBy             User?               @relation("EscalatedBy", fields: [escalatedById], references: [id], onDelete: SetNull)
  isSystemGenerated       Boolean             @default(true)
  acknowledgedById        String?             @db.Uuid
  acknowledgedBy          User?               @relation("EscalationAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt          DateTime?
  actionPlan              String?             @db.Text
  actionPlanRecordedAt    DateTime?
  actionPlanRecordedById  String?             @db.Uuid
  actionPlanRecordedBy    User?               @relation("EscalationActionPlanBy", fields: [actionPlanRecordedById], references: [id], onDelete: SetNull)
  resolvedAt              DateTime?
  resolvedById            String?             @db.Uuid
  resolvedBy              User?               @relation("EscalationResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionReason        String?             @db.Text
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  actionLogs              EscalationActionLog[]

  @@index([complaintId])
  @@index([status])
  @@index([escalationLevel])
  @@index([escalatedToDepartmentId])
  @@index([escalatedToOfficialId])
  @@map("complaint_escalations")
}

model EscalationActionLog {
  id           String              @id @default(uuid()) @db.Uuid
  escalationId String              @db.Uuid
  escalation   ComplaintEscalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  actorId      String?             @db.Uuid
  actor        User?               @relation("UserEscalationLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action       String              @db.VarChar(100)
  notes        String?             @db.Text
  createdAt    DateTime            @default(now())

  @@index([escalationId])
  @@index([createdAt])
  @@map("escalation_action_logs")
}

model SlaExtensionRequest {
  id                          String                 @id @default(uuid()) @db.Uuid
  complaintId                 String                 @db.Uuid
  complaint                   Complaint              @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintSlaId              String                 @db.Uuid
  complaintSla                ComplaintSla           @relation(fields: [complaintSlaId], references: [id], onDelete: Cascade)
  requestedByOfficialId       String                 @db.Uuid
  requestedByOfficial         User                   @relation("RequestedSlaExtensions", fields: [requestedByOfficialId], references: [id], onDelete: Cascade)
  previousResolutionDeadline  DateTime
  requestedResolutionDeadline DateTime
  reason                      String                 @db.Text
  status                      ExtensionRequestStatus @default(PENDING)
  decisionById                String?                @db.Uuid
  decisionBy                  User?                  @relation("DecidedSlaExtensions", fields: [decisionById], references: [id], onDelete: SetNull)
  decisionNotes               String?                @db.Text
  decisionAt                  DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  @@index([complaintId])
  @@index([status])
  @@index([requestedByOfficialId])
  @@map("sla_extension_requests")
}

// ==========================================
// O. CONTENT MODERATION, FRAUD & ABUSE PREVENTION
// ==========================================

model AbuseReport {
  id                  String            @id @default(uuid()) @db.Uuid
  trackingId          String            @unique @db.VarChar(32)
  targetType          ReportTargetType
  targetId            String            @db.Uuid
  reporterId          String?           @db.Uuid
  reporter            User?             @relation("UserReportedAbuse", fields: [reporterId], references: [id], onDelete: SetNull)
  reason              AbuseReportReason
  explanation         String?           @db.Text
  status              AbuseReportStatus @default(PENDING)
  caseId              String?           @db.Uuid
  case                ModerationCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  ipAddress           String?           @db.VarChar(45)
  assignedModeratorId String?           @db.Uuid
  assignedModerator   User?             @relation("AssignedAbuseReports", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  resolutionNotes     String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
  @@index([caseId])
  @@index([assignedModeratorId])
  @@index([createdAt])
  @@map("abuse_reports")
}

model ModerationCase {
  id                  String               @id @default(uuid()) @db.Uuid
  caseNumber          String               @unique @db.VarChar(32)
  targetType          ReportTargetType
  targetId            String               @db.Uuid
  targetOwnerId       String?              @db.Uuid
  targetOwner         User?                @relation("TargetedModerationCases", fields: [targetOwnerId], references: [id], onDelete: SetNull)
  status              ModerationCaseStatus @default(OPEN)
  priority            ModerationPriority   @default(MEDIUM)
  riskScore           Int                  @default(0)
  riskFactors         Json?
  assignedModeratorId String?              @db.Uuid
  assignedModerator   User?                @relation("AssignedModerationCases", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  internalNotes       String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  reports             AbuseReport[]
  actions             ModerationAction[]
  appeals             ModerationAppeal[]

  @@index([targetType, targetId])
  @@index([status])
  @@index([priority])
  @@index([assignedModeratorId])
  @@index([targetOwnerId])
  @@index([createdAt])
  @@map("moderation_cases")
}

model ModerationAction {
  id             String               @id @default(uuid()) @db.Uuid
  caseId         String               @db.Uuid
  case           ModerationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  moderatorId    String?              @db.Uuid
  moderator      User?                @relation("UserModerationActions", fields: [moderatorId], references: [id], onDelete: SetNull)
  actionType     ModerationActionType
  reason         String               @db.Text
  internalNotes  String?              @db.Text
  targetSnapshot Json?
  isAutomated    Boolean              @default(false)
  createdAt      DateTime             @default(now())

  @@index([caseId])
  @@index([moderatorId])
  @@index([actionType])
  @@index([createdAt])
  @@map("moderation_actions")
}

model ModerationAppeal {
  id             String         @id @default(uuid()) @db.Uuid
  caseId         String         @db.Uuid
  case           ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  appellantId    String         @db.Uuid
  appellant      User           @relation("UserAppeals", fields: [appellantId], references: [id], onDelete: Cascade)
  reason         String         @db.Text
  status         AppealStatus   @default(PENDING)
  reviewerId     String?        @db.Uuid
  reviewer       User?          @relation("ReviewedAppeals", fields: [reviewerId], references: [id], onDelete: SetNull)
  decisionReason String?        @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([caseId])
  @@index([appellantId])
  @@index([status])
  @@index([createdAt])
  @@map("moderation_appeals")
}

model UserRestriction {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  user            User                @relation("TargetUserRestrictions", fields: [userId], references: [id], onDelete: Cascade)
  restrictionType UserRestrictionType
  reason          String              @db.Text
  expiresAt       DateTime?
  isActive        Boolean             @default(true)
  createdById     String?             @db.Uuid
  createdBy       User?               @relation("CreatedUserRestrictions", fields: [createdById], references: [id], onDelete: SetNull)
  liftedAt        DateTime?
  liftedById      String?             @db.Uuid
  liftedBy        User?               @relation("LiftedUserRestrictions", fields: [liftedById], references: [id], onDelete: SetNull)
  liftReason      String?             @db.Text
  createdAt       DateTime            @default(now())

  @@index([userId, isActive])
  @@index([restrictionType])
  @@index([expiresAt])
  @@map("user_restrictions")
}

model ComplaintDuplicateLink {
  id                   String    @id @default(uuid()) @db.Uuid
  primaryComplaintId   String    @db.Uuid
  primaryComplaint     Complaint @relation("PrimaryComplaintDuplicates", fields: [primaryComplaintId], references: [id], onDelete: Cascade)
  duplicateComplaintId String    @db.Uuid
  duplicateComplaint   Complaint @relation("DuplicateComplaintLinks", fields: [duplicateComplaintId], references: [id], onDelete: Cascade)
  similarityScore      Float     @default(0.0)
  reason               String?   @db.Text
  linkedById           String?   @db.Uuid
  linkedBy             User?     @relation("UserLinkedDuplicates", fields: [linkedById], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())

  @@unique([primaryComplaintId, duplicateComplaintId])
  @@index([primaryComplaintId])
  @@index([duplicateComplaintId])
  @@map("complaint_duplicate_links")
}

// ==========================================
// R. SYSTEM ADMINISTRATION & OPERATIONAL HEALTH
// ==========================================

model PlatformSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  category    String   @default("GENERAL") @db.VarChar(50)
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("UpdatedPlatformSettings", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  changeLogs ConfigurationChangeLog[]

  @@index([category])
  @@map("platform_settings")
}

model ConfigurationChangeLog {
  id            String          @id @default(uuid()) @db.Uuid
  settingId     String          @db.Uuid
  setting       PlatformSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  key           String          @db.VarChar(100)
  previousValue String?         @db.Text
  newValue      String          @db.Text
  reason        String?         @db.Text
  changedById   String?         @db.Uuid
  changedBy     User?           @relation("UserConfigChanges", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([key])
  @@index([createdAt])
  @@map("configuration_change_logs")
}

model OperationalIncident {
  id              String    @id @default(uuid()) @db.Uuid
  incidentNumber  String    @unique @db.VarChar(50)
  title           String    @db.VarChar(255)
  description     String    @db.Text
  severity        String    @default("MEDIUM") @db.VarChar(50)
  subsystem       String    @db.VarChar(100)
  status          String    @default("OPEN") @db.VarChar(50)
  reportedById    String?   @db.Uuid
  reportedBy      User?     @relation("ReportedIncidents", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedToId    String?   @db.Uuid
  assignedTo      User?     @relation("AssignedIncidents", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolutionNotes String?   @db.Text
  resolvedAt      DateTime?
  resolvedById    String?   @db.Uuid
  resolvedBy      User?     @relation("ResolvedIncidents", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@map("operational_incidents")
}

// ==========================================
// P. TENDERS, BIDS & WORK EXECUTION (MODULE 17)
// ==========================================

model Tender {
  id                     String        @id @default(uuid()) @db.Uuid
  tenderNumber           String        @unique @db.VarChar(64)
  title                  String        @db.VarChar(255)
  description            String        @db.Text
  departmentId           String        @db.Uuid
  department             Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  civicWorkId            String?       @db.Uuid
  civicWork              CivicWork?    @relation(fields: [civicWorkId], references: [id], onDelete: SetNull)
  categoryCode           String        @db.VarChar(50)
  location               String        @db.VarChar(255)
  ward                   String?       @db.VarChar(100)
  estimatedBudget        Decimal       @db.Decimal(14, 2)
  earnestMoneyDeposit    Decimal?      @db.Decimal(14, 2)
  minimumContractorClass String?       @default("ANY") @db.VarChar(50)
  status                 TenderStatus  @default(DRAFT)
  publicationDate        DateTime?
  submissionDeadline     DateTime
  expectedDurationDays   Int?
  eligibilityCriteria    String?       @db.Text
  scopeOfWork            String?       @db.Text
  createdById            String        @db.Uuid
  createdBy              User          @relation("CreatedTenders", fields: [createdById], references: [id], onDelete: Restrict)
  awardedBidId           String?       @unique @db.Uuid
  awardedBid             TenderBid?    @relation("AwardedTenderBid", fields: [awardedBidId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  bids                   TenderBid[]   @relation("TenderBids")
  workOrders             WorkOrder[]
  documents              Document[]

  @@index([tenderNumber])
  @@index([status])
  @@index([departmentId])
  @@index([civicWorkId])
  @@index([categoryCode])
  @@index([submissionDeadline])
  @@map("tenders")
}

model TenderBid {
  id                      String      @id @default(uuid()) @db.Uuid
  bidNumber               String      @unique @db.VarChar(64)
  tenderId                String      @db.Uuid
  tender                  Tender      @relation("TenderBids", fields: [tenderId], references: [id], onDelete: Cascade)
  contractorId            String      @db.Uuid
  contractor              Contractor  @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  submittedById           String      @db.Uuid
  submittedBy             User        @relation("SubmittedBids", fields: [submittedById], references: [id], onDelete: Restrict)
  bidAmount               Decimal     @db.Decimal(14, 2)
  proposedDurationDays    Int
  technicalProposal       String      @db.Text
  methodology             String?     @db.Text
  declarationAccepted     Boolean     @default(true)
  status                  BidStatus   @default(SUBMITTED)
  officialEvaluationNotes String?     @db.Text
  evaluatedById           String?     @db.Uuid
  evaluatedBy             User?       @relation("EvaluatedBids", fields: [evaluatedById], references: [id], onDelete: SetNull)
  evaluatedAt             DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  awardedTender           Tender?     @relation("AwardedTenderBid")
  workOrder               WorkOrder?
  documents               Document[]

  @@unique([tenderId, contractorId])
  @@index([tenderId])
  @@index([contractorId])
  @@index([submittedById])
  @@index([status])
  @@map("tender_bids")
}

model WorkStartDeclaration {
  id                String          @id @default(uuid()) @db.Uuid
  workOrderId       String          @db.Uuid
  workOrder         WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  contractorId      String          @db.Uuid
  contractor        Contractor      @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  submittedById     String          @db.Uuid
  submittedBy       User            @relation("SubmittedWorkStarts", fields: [submittedById], references: [id], onDelete: Restrict)
  declaredStartDate DateTime
  siteAddress       String          @db.Text
  latitude          Decimal?        @db.Decimal(10, 7)
  longitude         Decimal?        @db.Decimal(10, 7)
  siteNotes         String          @db.Text
  status            WorkStartStatus @default(SUBMITTED)
  verifiedById      String?         @db.Uuid
  verifiedBy        User?           @relation("VerifiedWorkStarts", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt        DateTime?
  reviewNotes       String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  documents         Document[]

  @@index([workOrderId])
  @@index([contractorId])
  @@index([status])
  @@map("work_start_declarations")
}

model ContractMilestone {
  id                        String          @id @default(uuid()) @db.Uuid
  workOrderId               String          @db.Uuid
  workOrder                 WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  milestoneNumber           Int
  title                     String          @db.VarChar(255)
  description               String          @db.Text
  targetPhysicalPercentage  Decimal         @db.Decimal(5, 2)
  targetAmount              Decimal?        @db.Decimal(14, 2)
  targetDueDate             DateTime?
  status                    MilestoneStatus @default(PENDING)
  claimedDate               DateTime?
  claimedPhysicalPercentage Decimal?        @db.Decimal(5, 2)
  claimedNotes              String?         @db.Text
  claimedById               String?         @db.Uuid
  claimedBy                 User?           @relation("ClaimedMilestones", fields: [claimedById], references: [id], onDelete: SetNull)
  reviewedById              String?         @db.Uuid
  reviewedBy                User?           @relation("ReviewedMilestones", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                DateTime?
  reviewerRemarks           String?         @db.Text
  rejectionReason           String?         @db.Text
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  documents                 Document[]

  @@unique([workOrderId, milestoneNumber])
  @@index([workOrderId])
  @@index([status])
  @@map("contract_milestones")
}

model DefectWarrantyRequest {
  id                 String       @id @default(uuid()) @db.Uuid
  trackingId         String       @unique @db.VarChar(32)
  workOrderId        String       @db.Uuid
  workOrder          WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  contractorId       String       @db.Uuid
  contractor         Contractor   @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  reportedById       String       @db.Uuid
  reportedBy         User         @relation("ReportedDefects", fields: [reportedById], references: [id], onDelete: Restrict)
  title              String       @db.VarChar(255)
  description        String       @db.Text
  location           String       @db.VarChar(255)
  severity           String       @default("MEDIUM") @db.VarChar(50)
  status             DefectStatus @default(REPORTED)
  isWarrantyCovered  Boolean      @default(true)
  rectificationNotes String?      @db.Text
  rectifiedAt        DateTime?
  verifiedById       String?      @db.Uuid
  verifiedBy         User?        @relation("VerifiedDefects", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?
  closureRemarks     String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  documents          Document[]

  @@index([trackingId])
  @@index([workOrderId])
  @@index([contractorId])
  @@index([status])
  @@map("defect_warranty_requests")
}

