{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://civora-l06w.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://civora-l06w.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
